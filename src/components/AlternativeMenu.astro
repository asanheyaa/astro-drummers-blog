---
import { useTranslations } from "../scripts/i18n.js";
import { withBase } from "../scripts/utils";
const lang = Astro.currentLocale ?? "de";
const t = useTranslations(lang);

const currentPath = Astro.url.pathname;
---

<div
  class="secondary-menu pop-up"
  data-pop-up="secondary-menu"
  data-speed="400"
  data-opening="M 0,0 c 0,0 63.5,-16.5 80,0 16.5,16.5 0,60 0,60 L 0,60 Z"
>
  <button
    type="button"
    data-pop-up-close="secondary-menu"
    class="secondary-menu__close-button pop-up__close-button"
    aria-label="close menu"
  >
    <i class="dfd-socicon-icon-close-round"></i>
  </button>
  <div class="secondary-menu__back pop-up__back">
    <svg
      data-pop-up-back="secondary-menu"
      xmlns="http://w3.org"
      width="100%"
      height="100%"
      viewBox="0 0 80 60"
      preserveAspectRatio="none"
    >
      <path d="M 0,0 c 0,0 -16.5,43.5 0,60 16.5,16.5 80,0 80,0 L 0,60 Z"></path>
      <defs></defs>
    </svg>
  </div>
  <div class="secondary-menu__wrapper pop-up__wrapper">
    <nav class="secondary-menu__nav">
      {
        t("header", "secondaryMenu.columns").map((item, i) => {
          const socials = t("header", `secondaryMenu.columns.${i}.socialItems`);

          return (
            <ul class="secondary-menu__list">
              <li class="secondary-menu__item">
                <h2 class="secondary-menu__title">
                  <a href={withBase(item.href)} class="secondary-menu__link">
                    {item.title}
                  </a>
                </h2>
              </li>
              {item.links.map((link) => {
                let href = link.href;
                const [hrefWithoutHash, anchor] = href.split("#");
                if (currentPath === hrefWithoutHash && anchor) {
                  href = `#${anchor}`;
                }

                return (
                  <li class="secondary-menu__item">
                    <a href={withBase(href)} class="secondary-menu__link">
                      {link.label}
                    </a>
                  </li>
                );
              })}

              {Array.isArray(socials) &&
                socials.map((social) => (
                  <>
                    <li class="secondary-menu__item">
                      <div class="secondary-menu__label">{social.title}</div>
                    </li>
                    {social.socialLinks.map((socialLink) => (
                      <li class="secondary-menu__item">
                        <a
                          href={socialLink.socialLink}
                          class="secondary-menu__link"
                        >
                          {socialLink.socialLabel}
                        </a>
                      </li>
                    ))}
                  </>
                ))}
            </ul>
          );
        })
      }
