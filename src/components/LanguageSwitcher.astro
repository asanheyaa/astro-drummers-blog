---
import { getCollection } from "astro:content";
import { languages } from "../scripts/i18n.js";
import { withBase, getCategoryLink } from "../scripts/utils.js";
import { getRelativeLocaleUrl } from "astro:i18n";
const { type, articleId, categoryId } = Astro.props;

const { lang } = Astro.locals;
const targetLang = lang === "de" ? "en" : "de";

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
const rawPath = Astro.url.pathname;
const relativePath = baseUrl ? rawPath.replace(baseUrl, "") : rawPath;
const pathWithoutLocale = relativePath.replace(/^\/en\/?/, "/");

function getLocalizedPath(lang) {
  const cleanPath = pathWithoutLocale.startsWith("/")
    ? pathWithoutLocale.slice(1)
    : pathWithoutLocale;

  if (lang === "de") {
    return `${baseUrl}/${cleanPath}`;
  }
  return `${baseUrl}/en/${cleanPath}`;
}
const targetPath = getLocalizedPath(targetLang);

async function getPath(lang) {
  if (articleId) {
    //article Switch
    const posts = await getCollection("posts");

    const exactArticle = posts.find(
      (post) => post.data.translationId === articleId && post.data.lang === lang
    );
    if (!exactArticle) {
      return lang === "de" ? withBase("/blog") : withBase("/en/blog");
    }

    if (lang === "de") {
      return withBase(`/blog/${exactArticle.data.slug}`);
    }
    return withBase(`/en/blog/${exactArticle.data.slug}`);
  } else if (categoryId) {
    //category switch
    const posts = await getCollection("posts");
    const exactPost = posts.find((post) => {
      if (post.data.lang !== lang) return false;

      const isMain = post.data.translationId === categoryId;

      const isAdditional = post.data.additionalsCategories?.some(
        (cat) => cat.id === categoryId
      );
      return isMain || isAdditional;
    });

    if (!exactPost) {
      return lang === "de" ? withBase("/blog") : withBase("/en/blog");
    }

    let categoryTitle = "";

    if (exactPost.data.translationId === categoryId) {
      categoryTitle = exactPost.data.mainCategory;
    } else {
      const foundCat = exactPost.data.additionalsCategories?.find(
        (cat) => cat.id === categoryId
      );
      categoryTitle = foundCat ? foundCat.title : "";
    }
    return getCategoryLink(categoryTitle, lang);
  } else {
    console.log(targetPath);
    return targetPath;
  }
}

const path = await getPath(targetLang);
---

{
  !type ? (
    <li class="header-menu__item">
      <a href={path} class="header-menu__link">
        {targetLang.toUpperCase()}
      </a>
    </li>
  ) : (
    Object.entries(languages).map(([code, label]) => (
      <li class="home-hero__item">
        <a
          href={path}
          class:list={["home-hero__link", { _active: code === lang }]}
          aria-current={code === lang ? "page" : undefined}
        >
          {code.toUpperCase()}
        </a>
      </li>
    ))
  )
}
