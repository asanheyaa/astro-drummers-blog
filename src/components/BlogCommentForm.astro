---
import { useTranslations } from "../scripts/i18n";
import Button from "./Button.astro";

const { formData, ...rest } = Astro.props;

const { lang } = Astro.locals;
const t = useTranslations(lang);
---

<form action="#" class="comments-post-form" {...rest}>
  <div class="comments-post-form__body">
    
    <div class="comments-post-form__items">
      <div class="comments-post-form__item">
   
        <input
          type="text"
          name="name"
          id="userName"
          class="comments-post-form__input"
          autocomplete="name"
          required={t("singlePost", "commentForm.fields.name.required")
            ? true
            : undefined}
             placeholder={t("singlePost", "commentForm.fields.name.label")}
        />
      </div>
      <div class="comments-post-form__item">
    
        <input
          type="email"
          name="email"
          id="userEmail"
          class="comments-post-form__input"
          autocomplete="email"
          required={t("singlePost", "commentForm.fields.email.required")
            ? true
            : undefined}
            placeholder={t("singlePost", "commentForm.fields.email.label")}
        />
      </div>
     
    </div>
    <div class="comments-post-form__item">
      <textarea
        name="Comment"
        id="message"
        class="comments-post-form__input comments-post-form__input-area"
        required={t("singlePost", "commentForm.fields.comment.required")
          ? true
          : undefined} placeholder={t("singlePost", "commentForm.fields.comment.label")}></textarea>
    </div>
  </div>
  <Button type="button" class="comments-post-form__button">
    {t("singlePost", "commentForm.submitButton")}
  </Button>
</form>
