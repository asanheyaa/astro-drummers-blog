---
import { getPostShareLink } from "../scripts/utils.js";

const { lang } = Astro.locals;
const {
  slug,
  isVertical,
  label,
  class: className,
  facebookCounter,
} = Astro.props;
---

<div
  class:list={[
    "share-buttons",
    { "share-buttons--vertical": isVertical, [className]: className },
  ]}
>
  <ul class="share-buttons__list">
    <li class="share-buttons__item">
      <a
        href={getPostShareLink(slug, lang, Astro.site)}
        class="share-buttons__link share-buttons__link-facebook"
        data-text={label}
      >
        <div class="share-buttons__icon">
          <i class="dfd-socicon-facebook"> </i>
        </div>
        {
          (
            <span class="share-buttons__counter">
              {" "}
              {facebookCounter || "0"}
            </span>
          )
        }
      </a>
    </li>
    <li class="share-buttons__item">
      <a
        href={slug}
        class="share-buttons__link share-buttons__link-instagram"
        data-text={label}
      >
        <div class="share-buttons__icon">
          <i class="dfd-socicon-instagram"> </i>
        </div>
      </a>
    </li>
  </ul>
</div>
