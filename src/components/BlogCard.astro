---
import { Image } from "astro:assets";

const {
  cover,
  date,
  category,
  title,
  description,
  alt,
  slug,
  categoryUrl,
  postUrl,
  isGrid,
  ...rest
} = Astro.props;
---

{
  isGrid ? (
    <article class="article --isGrid" {...rest}>
      <a href={postUrl} class="article__photo ibg">
        <Image width={382} height={382} src={cover} alt={alt} />
      </a>
      <a href={categoryUrl} class="article__category">
        {" "}
        {category}{" "}
      </a>
      <footer class="article__footer">
        <div class="article__row">
          <div class="article__date">
            <div class="article__icon">
              <i class="dfd-socicon-clock"> </i>
            </div>
            <div class="article__time">
              {date} in{" "}
              <a href={categoryUrl} class="article__link">
                {category}
              </a>
            </div>
          </div>
          <div class="article__actions">
            <a href="#" class="article__action-button">
              <span class="article__action-icon">
                <i class="dfd-socicon-Untitled-2-37" />
              </span>
              <span class="article__action-counter">
                0
              </span>
            </a>
            <button type="button" class="article__action-button">
              <span class="article__action-icon">
                <i class="dfd-socicon-icon-ios7-heart" />
              </span>
              <span class="article__action-counter">
                0
              </span>
            </button>
          </div>
        </div>
        <h3 class="article__label">
          <a href={postUrl} class="article__label-link">
            {title}
          </a>
        </h3>
        <div class="article__text">{description}</div>
      </footer>
    </article>
  ) : (
    <article class="article" {...rest}>
      <a href={postUrl} class="article__photo ibg">
        <Image width={382} height={382} src={cover} alt={alt} />
      </a>
      <a href={categoryUrl} class="article__category">
        {" "}
        {category}{" "}
      </a>
      <footer class="article__footer">
        <div class="article__date">
          <div class="article__icon">
            <i class="dfd-socicon-clock"> </i>
          </div>
          <div class="article__time">
            {date} in{" "}
            <a href={categoryUrl} class="article__link">
              {category}
            </a>
          </div>
        </div>
        <h3 class="article__label">
          <a href={postUrl} class="article__label-link">
            {title}
          </a>
        </h3>
        <div class="article__text">{description}</div>
      </footer>
    </article>
  )
}
