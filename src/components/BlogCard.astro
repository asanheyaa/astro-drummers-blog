---
import { Image } from "astro:assets";
import Date from "./Date.astro";
import Category from "./Category.astro";
import CommentsButton from "./CommentsButton.astro";
import LikeButton from "./LikeButton.astro";

const {
  src,
  date,
  category,
  title,
  description,
  alt,
  slug,
  categoryUrl,
  postUrl,
  isGrid,
  isAlt,
  width = 382,
  height = 382,
  likesCounter = 0,
  commentsCounter = 0,
  commentsLink,
  postId,
  ...rest
} = Astro.props;
---

<article
  class:list={["article", { "--isGrid": isGrid, "--isAlt": isAlt }]}
  data-post-id={postId}
  {...rest}
>
  <a href={postUrl} class="article__photo ibg">
    <Image width={width} height={height} src={src} alt={alt} />
  </a>

  {
    category && (
      <Category url={categoryUrl} label={category} class="article__category" />
    )
  }
  <footer class="article__footer">
    <div class="article__row">
      <Date date={date} class="article__date" />
      {" in "}
      <a href={categoryUrl} class="article__link">
        {category}
      </a>
      {
        isGrid && (
          <div class="article__actions">
            <CommentsButton
              commentsLink={commentsLink}
              commentsCounter={commentsCounter}
            />
            <LikeButton postId={postId} likesCounter={likesCounter} />
          </div>
        )
      }
    </div>
    <h3 class="article__label">
      <a href={postUrl} class="article__label-link">
        {title}
      </a>
    </h3>
    {description && <div class="article__text">{description}</div>}
  </footer>
</article>
