---
const { items, categories, categoryName = null,filterTitle, tags } = Astro.props;
import {
  getCategoryLink,
  getFilteredArticles,
  getPostLink,
  getTagLink,
  withBase,

} from "../scripts/utils";

const { lang } = Astro.locals;
---

<div class="filter" data-dropdown="vertical">
  <button class="filter__button" data-dropdown-trigger>
    <span class="filter__icon"> <i class="fa fa-tags"></i> </span>
    <span class="filter__value"> {categoryName || filterTitle}</span>
  </button>
  <div class="filter__body" data-dropdown-body >
    <div class="filter__wrapper">
      <button
        type="button"
        class="filter__close-button"
        aria-label="close Filter"
        data-dropdown-close
      >
        <i class="dfd-socicon-icon-close-round">
      
        </i>
      </button>
      <ul class="filter__list" data-lenis-prevent>
        {
          categories &&
            categories.map((item) => {
              const categoryUrl = getCategoryLink(item.slug, lang);
              if (categoryName !== item.title) {
                return (
                  <li class="filter__item">
                    <a href={categoryUrl} class="filter__link">
                      {item.title}
                    </a>
                  </li>
                );
              }
            })
        }

        {
           tags &&
            tags.map((item) => {
              const categoryUrl = getTagLink(item.slug, lang);
              if (categoryName !== item.title) {
                return (
                  <li class="filter__item">
                    <a href={categoryUrl} class="filter__link">
                      {item.title}
                    </a>
                  </li>
                );
              }
            })
        }
      </ul>
    </div>
  </div>
</div>
