---
import Filter from "./Filter.astro";
import SearchHero from "./SearchHero.astro";
import "../styles/fontawesome.scss";

const {
  isAlt,
  title,
  autor,
  date,
  commentsCounter,
  commentsLink,
  viewsCounter,
  likesCounter,
  slug,
  autorPrefix,
  facebookCounter,
  inputPlaceholder,
  categories,
} = Astro.props;
---

<section
  class="hero"
  aria-labelledby="hero-title"
  data-animation-parallax-wrapper
>
  <div class="hero__container">
    <h1
      class:list={["hero__title", { "hero__title-alt": isAlt }]}
      data-animation-parallax-element
      id="hero-title"
    >
      {title}
    </h1>
    <div class="hero-actions">
      <Filter categories={categories} />
      <SearchHero inputPlaceholder={inputPlaceholder} />
    </div>
  </div>
</section>
