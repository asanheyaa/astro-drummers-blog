---
import Filter from "./Filter.astro";
import SearchHero from "./SearchHero.astro";
import "../styles/fontawesome.scss";
import Date from "./Date.astro";
import CommentsButton from "./CommentsButton.astro";
import LikeButton from "./LikeButton.astro";

const {
  isAlt,
  title,
  categories,
  categoryName,
  noFilter,
  searchTitle,
  searchPlaceholder,
  filterTitle,
  isArticle,
  date,
  commentsCounter,
  commentsLink,
  viewsCounter,
  likesCounter,
  tags
} = Astro.props;

---

<section
  class="hero"
  aria-labelledby="hero-title"
  data-animation-parallax-wrapper
>
  <div class="hero__container">
    <h1
      class:list={["hero__title", { "hero__title-alt": isAlt }]}
      data-animation-parallax-element
      id="hero-title"
    >
      {title}
    </h1>
    {
      !noFilter && (
        <div class="hero-actions">
          <Filter
            categories={categories}
            tags={tags}
            categoryName={categoryName}
            filterTitle={filterTitle}
          />
          <SearchHero
            i
            searchTitle={searchTitle}
            searchPlaceholder={searchPlaceholder}
          />
        </div>
      )
    }

    {
      isArticle && (
        <footer class="footer-hero">
          <div class="footer-hero__autor"></div>
          <div class="footer-hero__details">
            <div class="footer-hero__item">
              <Date date={date} />
            </div>

            <CommentsButton
              commentsLink={commentsLink}
              commentsCounter={commentsCounter}
              class="footer-hero__item"
            />
            <div class="footer-hero__item">
              <span>{viewsCounter} </span> <span>Views</span>
            </div>
            <LikeButton likesCounter={likesCounter} class="footer-hero__item" />
          </div>
         
        </footer>
      )
    }
  </div>
</section>
