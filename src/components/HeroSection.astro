---
import Filter from "./Filter.astro";
import SearchHero from "./SearchHero.astro";
import "../styles/fontawesome.scss";

const { isAlt, title, categories, categoryName, noFilter,searchTitle, searchPlaceholder,filterTitle } =
  Astro.props;
  
---

<section
  class="hero"
  aria-labelledby="hero-title"
  data-animation-parallax-wrapper
>
  <div class="hero__container">
    <h1
      class:list={["hero__title", { "hero__title-alt": isAlt }]}
      data-animation-parallax-element
      id="hero-title"
    >
      {title}
    </h1>
    {
      !noFilter && (
        <div class="hero-actions">
          <Filter categories={categories} categoryName={categoryName} filterTitle={filterTitle} />
          <SearchHero i  searchTitle={searchTitle} searchPlaceholder={searchPlaceholder}/>
        </div>
      )
    }
  </div>
</section>
