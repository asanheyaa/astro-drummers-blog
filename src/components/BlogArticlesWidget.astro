---
import Image from "astro/components/Image.astro";
import { useTranslations } from "../scripts/i18n.js";
import { getFilteredArticles, getPostLink } from "../scripts/utils.js";
import Date from "./Date.astro";
import LikeButton from "./LikeButton.astro";
import { getCollection } from "astro:content";

const { lang } = Astro.locals;
const t = useTranslations(lang);

const posts = await getCollection("posts");
const articles = getFilteredArticles(posts, lang, 5);
---

<aside class="aside-widget">
  <div class="aside-widget__body">
    <form action="#" class="form-aside-widget">
      <input
        type="text"
        name="search"
        id="asideWidgetSearch"
        class="form-aside-widget__input"
      />
      <button
        type="submit"
        class="form-aside-widget__button"
        aria-label="submit search"
      >
        <i class="dfd-socicon-Search"></i>
      </button>
    </form>
    <div class="aside-widget__items">
      {
        articles.map((article) => {
          const postUrl = getPostLink(article.data.slug, lang);

          return (
            <article class="aside-widget__item">
              <div class="aside-widget__image">
                <Image
                  src={article.data.cover}
                  alt={article.data.title}
                  width={80}
                  height={80}
                />
              </div>
              <div class="aside-widget__details">
                <h2 class="aside-widget__title">
                  <a href={postUrl} class="aside-widget__link">
                    {article.data.title}
                  </a>
                </h2>
                <footer class="aside-widget__footer">
                  <Date date="21.03.2021" />
                  <LikeButton
                    likesCounter={article.data.counters.likes}
                    postId={article.data.id}
                  />
                </footer>
              </div>
            </article>
          );
        })
      }
    </div>
    <button
      type="button"
      class="aside-widget__button"
      aria-label="load more posts"
    >
      <span>
        {t("blog", "blog.asideWidget.buttonLabel")}
      </span>
      <i class="aside-widget__icon dfd-socicon-refresh"> </i>
    </button>
  </div>
</aside>
