---

<div class="share-dropdown" data-dropdown="horizontal">
  <button type="button" class="share-dropdown__button" data-dropdown-trigger>
    <i class="fa fa-share-alt"> </i>
  </button>
  <div class="share-dropdown__body" data-dropdown-body>
    <ul class="share-dropdown__list">
      <li class="share-dropdown__item">
        <a href="#" class="share-dropdown__link share-dropdown__link-01">
          <i class="fa fa-envelope"></i>
        </a>
      </li>
      <li class="share-dropdown__item">
        <a href="#" class="share-dropdown__link share-dropdown__link-02">
          <i class="fa fa-google-plus"></i>
        </a>
      </li>
      <li class="share-dropdown__item">
        <a href="#" class="share-dropdown__link share-dropdown__link-03">
          <i class="fa fa-twitter"></i>
        </a>
      </li>
      <li class="share-dropdown__item">
        <a href="#" class="share-dropdown__link share-dropdown__link-04">
          <i class="fa fa-facebook"></i>
        </a>
      </li>
    </ul>
  </div>
</div>
