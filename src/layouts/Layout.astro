---
const { isHeaderAnimated = false } = Astro.props;

import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Prealoder from "../components/Prealoder.astro";
import TopScrollButton from "../components/TopScrollButton.astro";
import SearchPopup from "../components/SearchPopup.astro";
import AlternativeMenu from "../components/AlternativeMenu.astro";
import Newsletter from "../components/Newsletter.astro";

import "../styles/main-styles.scss";

import { useTranslations } from "../scripts/i18n.js";
import { withBase } from "../scripts/utils";

const {
  title,
  metaDescription,
  ogType = null,
  ogImageUrl,
  ogImageSecureUrl,
  ogImageAlt,
  twitterLabel1,
  twitterData1,
  twitterImageUrl,
  twitterLabel2,
  twitterData2,
  articleId = null,
  categoryId = null,
  articleTags = null,
} = Astro.props;

const { lang } = Astro.locals;
const locale = lang === "de" ? "de_DE" : "en_US";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={metaDescription} />

    <meta
      name="robots"
      content="follow, index, max-snippet:-1, max-video-preview:-1, max-image-preview:large"
    />

    <!-- Open Graph / Facebook -->
    <meta property="og:locale" content={locale} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:site_name" content="Drummersblog" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageSecureUrl} />
    <meta property="og:image:height" content="315" />
    <meta property="og:image:width" content="828" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:image:type" content="image/jpeg" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={twitterImageUrl} />

    {twitterLabel1 && <meta name="twitter:label1" content={twitterLabel1} />}
    {twitterLabel2 && <meta name="twitter:label2" content={twitterLabel2} />}
    {twitterData1 && <meta name="twitter:data1" content={twitterData1} />}
    {twitterData2 && <meta name="twitter:data2" content={twitterData2} />}
    {ogType && <meta property="og:type" content={ogType} />}
    {
      articleTags &&
        articleTags.map((articleTag) => {
          return <meta property="article:tag" content={articleTag} />;
        })
    }
    <title>{title}</title>
    <link rel="icon" type="image/webp" href={withBase("/favicon.webp")} />

    <link
      href="https://fonts.googleapis.com/css?family=Merriweather:300,regular,500,600,700,800,900,300italic,italic,500italic,600italic,700italic,800italic,900italic"
      rel="stylesheet"
    />
    <!-- italic, 600-italic-->

    <link
      href="https://fonts.googleapis.com/css?family=Montserrat:100,200,300,regular,500,600,700,800,900,100italic,200italic,300italic,italic,500italic,600italic,700italic,800italic,900italic&display=swap"
      rel="stylesheet"
    />
    <!-- 700,400,600 -->
    <link
      href="https://fonts.googleapis.com/css?family=Open+Sans:300,regular,500,600,700,800,300italic,italic,500italic,600italic,700italic,800italic&display=swap"
      rel="stylesheet"
    />
    <!-- 700 -->
  </head>

  <body>
    <Prealoder />
    <SearchPopup />

    <AlternativeMenu />
    <TopScrollButton />
    <div class="wrapper">
      <Header
        articleId={articleId}
        isHeaderAnimated={isHeaderAnimated}
        categoryId={categoryId}
      />
      <main class="page">
        <slot />
        <Newsletter />
      </main>

      <Footer />
    </div>

    <script src="../scripts/app.js"></script>
  </body>
</html>
