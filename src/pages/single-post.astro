---
import Image from "astro/components/Image.astro";
import HeroSection from "../components/HeroSection.astro";
import { withBase } from "../scripts/utils";
import { useTranslations } from "../scripts/i18n";
import ShareButtons from "../components/ShareButtons.astro";
import BlogCommentForm from "../components/BlogCommentForm.astro";
import Category from "../components/Category.astro";
import Date from "../components/Date.astro";
import SwiperIniter from "../components/SwiperIniter.astro";
import BlogCard from "../components/BlogCard.astro";
import { getPostData } from "../services/singlePostService.js";
import Layout from "../layouts/Layout.astro";
import BlogArticlesWidget from "../components/BlogArticlesWidget.astro";

const lang = Astro.currentLocale ?? "de";
const t = useTranslations(lang);

const postData = await getPostData(lang);
---

<Layout>
  <HeroSection
    isAlt
    title={postData.title}
    autor={postData.autor}
    date={postData.date}
    commentsCounter={postData.comments.length}
    viewsCounter={postData.counters.views}
    likesCounter={postData.counters.likes}
    shareLink={postData.shareLink}
    autorPrefix={t("singlePost", "autor")}
    commentsLink={postData.commentsLink}
    facebookCounter={postData.counters.facebookCounter}
  />
  <div class="single-post-navigation">
    <div class="single-post-navigation__container">
      <div class="single-post-navigation__wrapper">
        {
          postData.previousPost && (
            <a
              href={postData.previousPost.link}
              class="single-post-navigation__item single-post-navigation__item-prev"
            >
              <div class="single-post-navigation__body">
                <i class="single-post-navigation__icon dfd-socicon-arrow-left-01" />
                <span class="single-post-navigation__label"> Prev </span>
              </div>
              <div class="single-post-navigation__content">
                <div class="single-post-navigation__cover">
                  <Image
                    width={40}
                    height={40}
                    src={postData.previousPost.cover}
                    alt={postData.previousPost.title}
                  />
                </div>
                <div class="single-post-navigation__item__details">
                  <h2 class="single-post-navigation__title">
                    {postData.previousPost.title}
                  </h2>
                  <div class="single-post-navigation__date">
                    <i class="single-post-navigation__date-icon dfd-socicon-clock" />
                    <time
                      datetime={postData.previousPost.date}
                      class="single-post-navigation__item__time"
                    >
                      {postData.previousPost.date}
                    </time>
                  </div>
                  <div class="single-post-navigation__item__data" />
                </div>
              </div>
            </a>
          )
        }

        <a
          href={withBase(t("header", "header.nav.1.href"))}
          class="single-post-navigation__home"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            xmlns:xlink="http://www.w3.org/1999/xlink"
            version="1.1"
            id="Layer_1"
            viewBox="0 0 512 512"
            enable-background="new 0 0 512 512"
            xml:space="preserve"
            fill="#000000"
            ><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g
              id="SVGRepo_tracerCarrier"
              stroke-linecap="round"
              stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier">
              <g id="vinyl_record">
                <g>
                  <path
                    fill="#1f201c"
                    d="M256,0C114.609,0,0,114.617,0,256c0,141.375,114.609,256,256,256c141.375,0,256-114.625,256-256 C512,114.617,397.375,0,256,0z M256,266.664c-5.891,0-10.672-4.773-10.672-10.664s4.781-10.664,10.672-10.664 s10.656,4.773,10.656,10.664S261.891,266.664,256,266.664z"
                  ></path>
                </g>
                <g>
                  <path
                    fill="#9ed8ff"
                    d="M197.875,118.391c18.391-7.781,37.953-11.727,58.125-11.727c5.891,0,10.656-4.773,10.656-10.664 S261.891,85.336,256,85.336c-94.266,0-170.672,76.406-170.672,170.664c0,5.891,4.781,10.664,10.672,10.664 s10.656-4.773,10.656-10.664c0-20.172,3.953-39.727,11.734-58.117c7.516-17.781,18.297-33.758,32.016-47.477 S180.094,125.914,197.875,118.391z"
                  ></path>
                  <path
                    fill="#9ed8ff"
                    d="M314.109,393.609c-18.391,7.781-37.938,11.734-58.109,11.734c-5.891,0-10.672,4.766-10.672,10.656 s4.781,10.656,10.672,10.656c94.25,0,170.656-76.406,170.656-170.656c0-5.891-4.766-10.664-10.656-10.664 s-10.672,4.773-10.672,10.664c0,20.172-3.938,39.719-11.719,58.125c-7.531,17.781-18.297,33.75-32.016,47.469 S331.891,386.094,314.109,393.609z"
                  ></path>
                  <path
                    fill="#9ed8ff"
                    d="M181.266,79.078C204.922,69.07,230.062,64,256,64c5.891,0,10.656-4.773,10.656-10.664 S261.891,42.664,256,42.664C138.172,42.664,42.656,138.18,42.656,256c0,5.891,4.781,10.664,10.672,10.664S64,261.891,64,256 c0-25.93,5.062-51.07,15.078-74.727c9.672-22.859,23.516-43.398,41.156-61.039S158.406,88.75,181.266,79.078z"
                  ></path>
                  <path
                    fill="#9ed8ff"
                    d="M256,149.336c5.891,0,10.656-4.781,10.656-10.672S261.891,128,256,128l0,0c-70.703,0-128,57.305-128,128 c0,5.891,4.766,10.664,10.656,10.664s10.672-4.773,10.672-10.664c0-28.492,11.094-55.281,31.234-75.422 c20.156-20.148,46.938-31.242,75.422-31.242H256z"
                  ></path>
                  <path
                    fill="#9ed8ff"
                    d="M245.328,373.344c0,5.875,4.781,10.656,10.672,10.656c70.688,0,128-57.312,128-128 c0-5.891-4.781-10.664-10.672-10.664s-10.672,4.773-10.672,10.664c0,28.5-11.094,55.281-31.234,75.422 S284.484,362.656,256,362.656C250.109,362.656,245.328,367.438,245.328,373.344z"
                  ></path>
                  <path
                    fill="#9ed8ff"
                    d="M458.656,245.336c-5.891,0-10.656,4.773-10.656,10.664c0,25.938-5.078,51.062-15.078,74.719 c-9.672,22.875-23.516,43.406-41.156,61.047s-38.188,31.484-61.047,41.156C307.062,442.938,281.922,448,256,448 c-5.891,0-10.672,4.781-10.672,10.656c0,5.906,4.781,10.688,10.672,10.688c117.812,0,213.328-95.531,213.328-213.344 C469.328,250.109,464.547,245.336,458.656,245.336z"
                  ></path>
                </g>
                <path
                  fill="#ffde00"
                  d="M256,181.336c-41.172,0-74.672,33.492-74.672,74.664s33.5,74.656,74.672,74.656 s74.656-33.484,74.656-74.656S297.172,181.336,256,181.336z M256,266.664c-5.891,0-10.672-4.773-10.672-10.664 s4.781-10.664,10.672-10.664s10.656,4.773,10.656,10.664S261.891,266.664,256,266.664z"
                ></path>
                <path
                  fill="#ffde00"
                  d="M256,170.664c-47.125,0-85.344,38.211-85.344,85.336s38.219,85.344,85.344,85.344 s85.328-38.219,85.328-85.344S303.125,170.664,256,170.664z M256,320c-35.297,0-64-28.719-64-64c0-35.289,28.703-64,64-64 c35.281,0,64,28.711,64,64C320,291.281,291.281,320,256,320z"
                ></path>
              </g>
            </g></svg
          >
        </a>
        {
          postData.nextPost && (
            <a
              href={postData.nextPost.link}
              class="single-post-navigation__item single-post-navigation__item-next"
            >
              <div class="single-post-navigation__body">
                <span class="single-post-navigation__label"> Next </span>
                <i class="single-post-navigation__icon dfd-socicon-arrow-right-01" />
              </div>
              <div class="single-post-navigation__content">
                <div class="single-post-navigation__cover">
                  <Image
                    width={40}
                    height={40}
                    src={postData.nextPost.cover}
                    alt={postData.nextPost.title}
                  />
                </div>
                <div class="single-post-navigation__item__details">
                  <h2 class="single-post-navigation__title">
                    {postData.nextPost.title}
                  </h2>
                  <div class="single-post-navigation__date">
                    <i class="single-post-navigation__date-icon dfd-socicon-clock" />
                    <time
                      datetime={postData.nextPost.date}
                      class="single-post-navigation__item__time"
                    >
                      {postData.nextPost.date}
                    </time>
                  </div>
                </div>
              </div>
            </a>
          )
        }
      </div>
    </div>
  </div>
  <div class="content-wrapper">
    <div class="content-wrapper__container">
    

      <section class="single-post-body">
        <div class="single-post-body__buttons">
          <ShareButtons
            isVertical
            facebookCounter={postData.counters.facebookCounter}
            class="single-post-body__share"
          />
        </div>
        <article class="single-post-body__article">
          <div class="single-post-body__cover ibg">
            <Image
              width={985}
              height={660}
              alt={postData.title}
              src={postData.mainCover}
            />
          </div>
          <h3 class="single-post-body__title">
            {postData.title}
          </h3>
          <div
            class="single-post-body__content"
            set:html={postData.content.rendered}
          />
        </article>
        <footer class="footer-single-post">
          <div class="footer-single-post__container">
            <div class="footer-single-post__categories">
              <ul class="footer-single-post__list">
                {
                  postData.postCategories.map((item) => (
                    <li class="footer-single-post__item">
                      <Category
                        label={item.title}
                        url={item.url}
                        class="footer-single-post__category"
                      />
                    </li>
                  ))
                }
              </ul>
            </div>
            <div class="footer-single-post__actions">
              <button type="button" class="footer-single-post__button">
                <i
                  class="footer-single-post__like-icon dfd-socicon-icon-ios7-heart"
                >
                </i>
                <span class="footer-single-post__like-counter">
                  {postData.counters.likes}
                </span>
                {" "}
                <span>
                  {t("singlePost", "likes")}
                </span>
              </button>
              <div class="footer-single-post__socials">
                <ShareButtons
                  shareLink={postData.shareLink}
                  facebookCounter={postData.counters.facebookCounter}
                />
              </div>
            </div>
          </div>
        </footer>
      </section>
    </div>
  </div>

  {
    postData.comments?.length > 0 && (
      <section
        class="single-post-comments"
        aria-labelledby="single-post-comments-title"
        id="comments"
      >
        <div class="single-post-comments__container">
          <h2
            class="single-post-comments__title"
            id="single-post-comments-title"
          >
            {t(
              "singlePost",
              `comments.${postData.comments.length === 1 ? "commentsCountOne" : "commentsCountOther"}`,
              { count: postData.comments.length }
            )}
          </h2>
          <div class="single-post-comments__body">
            {postData.comments?.map((comment) => (
              <div class="single-post-comments__comment">
                <div class="single-post-comments__wrapper">
                  <header class="single-post-comments__header">
                    <div class="single-post-comments__details">
                      {comment.url ? (
                        <a
                          href={comment.url}
                          class="single-post-comments__autor"
                        >
                          {comment.autor}
                        </a>
                      ) : (
                        <div class="single-post-comments__autor">
                          {comment.autor}
                        </div>
                      )}
                      <Date date={comment.date} />
                    </div>
                    <a
                      href="#commentForm"
                      class="single-post-comments__reply-button"
                    >
                      <i class="dfd-socicon-icon-reply-all single-post-comments__reply-icon" />
                      <span>{t("singlePost", "comments.replyButton")}</span>
                    </a>
                  </header>
                  <div class="single-post-comments__content">
                    {comment.text}
                  </div>
                </div>
                {comment.replies && (
                  <div class="single-post-comments__replies">
                    {comment.replies?.map((reply) => (
                      <div class="single-post-comments__comment">
                        <div class="single-post-comments__wrapper">
                          <header class="single-post-comments__header">
                            <div class="single-post-comments__details">
                              {reply.url ? (
                                <a
                                  href={reply.url}
                                  class="single-post-comments__autor"
                                >
                                  {reply.autor}
                                </a>
                              ) : (
                                <div class="single-post-comments__autor">
                                  {reply.autor}
                                </div>
                              )}
                              <Date date={reply.date} />
                            </div>
                            <a
                              href="#commentForm"
                              class="single-post-comments__reply-button"
                            >
                              <i class="dfd-socicon-icon-reply-all single-post-comments__reply-icon" />
                              <span>
                                {t("singlePost", "comments.replyButton")}
                              </span>
                            </a>
                          </header>
                          <div class="single-post-comments__content">
                            {reply.text}
                          </div>
                        </div>
                      </div>
                    ))}
                  </div>
                )}
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }
  <section
    class="comments-single-post"
    aria-labelledby="comments-single-post-title"
    id="commentForm"
  >
    <div class="comments-single-post__container">
      <div class="comments-single-post__body">
        <header class="comments-single-post__header">
          <h2
            class="comments-single-post__title"
            id="comments-single-post-title"
          >
            {t("singlePost", "commentForm.title")}
          </h2>
          <div class="comments-single-post__subtitle">
            {t("singlePost", "commentForm.subtitle")}
          </div>
        </header>
        <BlogCommentForm
          commentFormData={t("singlePost", "commentForm.fields")}
        />
      </div>
    </div>
  </section>

  {
    postData.relatedPosts?.length > 0 && (
      <SwiperIniter>
        <section
          class="single-post-related"
          aria-labelledby="single-post-related-title"
        >
          <div class="single-post-related__container">
            <h2
              class="single-post-related__title"
              id="single-post-related-title"
            >
              {t("singlePost", "relatedPosts.title")}
            </h2>
            <div class="single-post-related__body">
              <div class="single-post-related__swiper swiper">
                <div class="single-post-related__wrapper swiper-wrapper">
                  {postData.relatedPosts.map((relatedPost) => (
                    <div class="single-post-related__slide swiper-slide">
                      <BlogCard
                        src={relatedPost.src}
                        alt={relatedPost.alt}
                        date={relatedPost.date}
                        category={relatedPost.category}
                        categoryUrl={relatedPost.categoryUrl}
                        title={relatedPost.title}
                        slug={relatedPost.slug}
                        postUrl={relatedPost.postUrl}
                        isGrid
                        isAlt
                        likesCounter={relatedPost.likesCounter}
                        commentsCounter={relatedPost.commentsCounter}
                        commentsLink={relatedPost.commentsLink}
                      />
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </section>
      </SwiperIniter>
    )
  }
</Layout>
