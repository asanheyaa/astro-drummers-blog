---
import { getCollection } from "astro:content";

import Layout from "../../../layouts/Layout.astro";

import BlogCardAlt from "../../../components/BlogCardAlt.astro";
import HeroSection from "../../../components/HeroSection.astro";

import { useTranslations } from "../../../scripts/i18n.js";

const { lang } = Astro.locals;

import {
  getCategoriesWithPosts,
  getCategoryLink,
  getCommentsLink,
  getPostLink,
} from "../../../scripts/utils.js";

import { getFilteredArticles } from "../../../scripts/utils.js";

const t = useTranslations(lang);

const allArticles = await getCollection("posts");
const langArticles = getFilteredArticles(allArticles, lang);
const categories = getCategoriesWithPosts(allArticles, lang);
---

<Layout
  title={t("blog", "meta.title")}
  metaDescription={t("blog", "meta.metaDescription")}
  ogLocale={t("blog", "meta.og.locale")}
  ogUrl={t("blog", "meta.og.url")}
  ogImageUrl={t("blog", "meta.og.image")}
  ogImageSecureUrl={t("blog", "meta.og.imageSecureUrl")}
  ogImageAlt={t("blog", "meta.og.imageAlt")}
  twitterImageUrl={t("blog", "meta.twitter.image")}
  twitterLabel1={t("blog", "meta.twitter.label1")}
  twitterData1={t("blog", "meta.twitter.data1")}
  twitterLabel2={t("blog", "meta.twitter.label2")}
  twitterData2={t("blog", "meta.twitter.data2")}
>
  <HeroSection
    title={t("blog", "blog.hero.title")}
    categories={categories}
    searchTitle={t("blog", "blog.hero.searchTitle")}
    searchPlaceholder={t("blog", "blog.hero.searchPlaceholder")}
    filterTitle={t("blog", "blog.hero.filterTitle")}
  />
  <section class="blog-articles">
    <div class="blog-articles__container">
      <div class="blog-articles__body">
        {
          langArticles.map((article) => {
            const postUrl = getPostLink(article.data.slug, lang);
            const commentsUrl = getCommentsLink(
              article.data.slug,
              lang,
              article.data.comments.length
            );
            const categoryUrl = getCategoryLink(
            article.data.category.title,
              lang
            );
            return (
              <BlogCardAlt
                id={article.data.id}
                postId={article.data.id}
                src={article.data.cover}
                alt={article.data.alt}
                title={article.data.title}
                description={article.data.description}
                date={article.data.date}
                postUrl={postUrl}
                autor={article.data.autor}
              />
            );
          })
        }
      </div>
      <button type="button" class="blog-articles__button button"
        >{t("blog", "blog.articles.buttonLabel")}</button
      >
    </div>
  </section>
</Layout>
