---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import BlogCard from "../../../../../components/BlogCard.astro";
import BlogPagination from "../../../../../components/BlogPagination.astro";
import HeroSection from "../../../../../components/HeroSection.astro";
import Layout from "../../../../../layouts/Layout.astro";

import { useTranslations } from "../../../../../scripts/i18n.js";
import {
  getCategoriesWithPosts,
  getCategoryLink,
  getCommentsLink,
  getPostLink,
  paginateItems,
} from "../../../../../scripts/utils.js";
import { PAGE_SIZE } from "../../../../../scripts/consts.js";
import BlogArticlesWidget from "../../../../../components/BlogArticlesWidget.astro";

const { lang } = Astro.locals;
const t = useTranslations(lang);

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  const categories = getCategoriesWithPosts(posts, "en");

  return categories.map((cat) => ({
    params: { category: cat.slug },
    props: {
      categorySlug: cat.slug,
      category: cat.title,
      categoryId: cat.id,
      categoryPosts: cat.posts,
    },
  }));
}

const { categoryPosts, category, categoryId, categorySlug } = Astro.props;

const {
  items: articles,
  currentPage,
  lastPage,
} = paginateItems(categoryPosts, 1, PAGE_SIZE);
---

<Layout
  isHeaderAnimated
  title={`${category} ${t("categories", "pageTitlePrefix")}`}
  metaDescription={t("blog", "meta.metaDescription")}
  ogLocale={t("blog", "meta.og.locale")}
  ogUrl={t("blog", "meta.og.url")}
  ogImageUrl={t("blog", "meta.og.image")}
  ogImageSecureUrl={t("blog", "meta.og.imageSecureUrl")}
  ogImageAlt={t("blog", "meta.og.imageAlt")}
  twitterImageUrl={t("blog", "meta.twitter.image")}
  twitterLabel1={t("categories", "meta.twitter.label1")}
  twitterData1={t("categories", `${categoryPosts.length || 0}`)}
  categoryId={categoryId}
>
  <HeroSection isAlt title={`${t("categories", "hero.title")} ${category}`} />
  <section class="blog-articles blog-articles-with-widget">
    <div class="blog-articles__container">
      <div class="blog-articles__body">
        {
          articles.map((article) => {
            const postUrl = getPostLink(article.data.slug, lang);
            const commentsUrl = getCommentsLink(
              article.data.slug,
              lang,
              article.data.comments.length
            );
            const categoryUrl = getCategoryLink(
              article.data.mainCategory,
              lang
            );
            return (
              <BlogCard
                key={article.data.id}
                postId={article.data.id}
                src={article.data.cover}
                alt={article.data.alt}
                title={article.data.title}
                description={article.data.description}
                date={article.data.date}
                category={article.data.mainCategory}
                categoryUrl={categoryUrl}
                postUrl={postUrl}
                commentsLink={commentsUrl}
                likesCounter={article.data.counters.likes}
                commentsCounter={article.data.comments.length}
                isGrid
              />
            );
          })
        }
      </div>
      <BlogArticlesWidget />

      {
        lastPage > 1 && (
          <footer class="blog-articles__footer">
            <BlogPagination
              currentPage={currentPage}
              lastPage={lastPage}
              baseUrl={getRelativeLocaleUrl(
                lang,
                `/blog/category/${categorySlug}`
              )}
            />
          </footer>
        )
      }
    </div>
  </section>
</Layout>
