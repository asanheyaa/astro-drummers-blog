---
import Layout from "../../../layouts/Layout.astro";
import HeroSection from "../../../components/HeroSection.astro";

import { useTranslations } from "../../../scripts/i18n.js";
import {
  getProductLink,
  getProductsCategories,
  buildSearchText,
  slugify,
} from "../../../scripts/utils.js";
import ProductCard from "../../../components/Card.astro";
import { getCollection } from "astro:content";
const { lang } = Astro.locals;
const t = useTranslations(lang);

const allProducts = await getCollection("products");
const products = allProducts.filter((product) => product.data.lang === lang);
const productCategories = getProductsCategories(allProducts, lang);
---

<Layout
  title={t("products", "translations.meta.title")}
  metaDescription={t("products", "translations.meta.metaDescription")}
  ogLocale={t("products", "translations.meta.og.locale")}
  ogUrl={t("products", "translations.meta.og.url")}
  ogImageUrl={t("products", "translations.meta.og.image")}
  ogImageSecureUrl={t("products", "translations.meta.og.imageSecureUrl")}
  ogImageAlt={t("products", "translations.meta.og.imageAlt")}
  twitterImageUrl={t("products", "translations.meta.twitter.image")}
  twitterLabel1={t("products", "translations.meta.twitter.label1")}
  twitterData1={t("products", "translations.meta.twitter.data1")}
>
  <HeroSection
    title={t("products", "translations.heroTitle")}
    searchTitle={t("blog", "blog.hero.searchTitle")}
    searchPlaceholder={t("products", "translations.serchInputPlaceholder")}
    filterTitle={t("blog", "blog.hero.filterTitle")}
    isProductPage
    categories={productCategories}
  />
  <section class="products">
    <div class="products__container">
      <div class="products__body">
        <div class="products__items">
          {
            products.length > 0 &&
              products.map((product) => {
                const productLink = getProductLink(
                  product.data.productId,
                  lang
                );
            
                return (
                  <ProductCard
                    id={product.data.productId}
                    src={product.data.image}
                    alt={product.data.title}
                    title={product.data.title}
                    description={product.data.shortDescription}
                    postUrl={productLink}
                    price={product.data.prices.currentPrice}
                    isProductCard
                    category={product.data.category}
                    searchText={buildSearchText(product.data)}
                    data-filter-id={slugify(product.data.category)}
                    currency= {product.data.prices.currency}
                  />
                );
              })
          }
        </div>
        <div id="no-results" class="products__no-results" hidden>
          {t("products", "translations.noResults")}
        </div>
      </div>
    </div>
  </section>
</Layout>
