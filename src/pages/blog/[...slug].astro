---
import { Image } from "astro:assets";
import HeroSection from "../../components/HeroSection.astro";
import { getFormattedDate, getPostLink } from "../../scripts/utils";
import { useTranslations } from "../../scripts/i18n.js";
import BlogCommentForm from "../../components/BlogCommentForm.astro";
import SwiperIniter from "../../components/SwiperIniter.astro";
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import BlogCardAlt from "../../components/BlogCardAlt.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts");

  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

const { post } = Astro.props;

const { lang } = Astro.locals;

const t = useTranslations(lang);
---

<Layout
  articleId={post.data.translationId}
  language={lang}
  title={post.data.title}
  metaDescription={post.data.description}
  description={post.data.description}
  ogLocale={t("blog", "meta.og.locale")}
  ogUrl={t("blog", "meta.og.url")}
  ogImageUrl={post.data.cover}
  ogImageSecureUrl={t("blog", "meta.og.imageSecureUrl")}
  ogImageAlt={post.data.title}
  twitterImageUrl={post.data.cover}
  twitterLabel1="Written by"
  twitterData1={"Ole Fahnick"}
  twitterLabel2="Time to read"
  twitterData2="Less than a minute"
  ogType="Article"
>
  <HeroSection
    isAlt
    title={post.data.title}
    noFilter
    searchTitle={t("blog", "blog.hero.searchTitle")}
    searchPlaceholder={t("blog", "blog.hero.searchPlaceholder")}
    filterTitle={t("blog", "blog.hero.filterTitle")}
  />

  <div class="content-wrapper">
    <div class="content-wrapper__container">
      <section class="single-post-body">
        <article class="single-post-body__article">
          <div class="single-post-body__cover ibg">
            <Image
              width={970}
              height={303}
              alt={post.data.title}
              src={post.data.cover}
            />
          </div>
          <div class="single-post-body__wrapper">
            <div class="single-post-body__category">
              {post.data.mainCategory}
            </div>
            <h3 class="single-post-body__title">
              {post.data.title}
            </h3>
            <div
              class="single-post-body__content"
              set:html={post.data.content.rendered}
            />
            <div class="single-post-body__post-data">
              <span class="single-post-body__date">
                {getFormattedDate(post.data.date)}
              </span>
              <span class="single-post-body__autor">
                {post.data.autor}
              </span>
            </div>
          </div>
        </article>
      </section>
    </div>
  </div>

  <section
    class="comments-single-post"
    aria-labelledby="comments-single-post-title"
    id="commentForm"
  >
    <div class="comments-single-post__container">
      <div class="comments-single-post__wrapper">
        {
          post.data.comments?.length > 0 && (
            <div class="single-post-comments">
              <h2
                class="single-post-comments__title"
                id="single-post-comments-title"
              >
                {t("singlePost", `comments.commentsTitle`)}
              </h2>
              <div class="single-post-comments__body">
                {post.data.comments?.map((comment) => (
                  <div class="single-post-comments__comment">
                    <div class="single-post-comments__wrapper">
                      <header class="single-post-comments__header">
                        <div class="single-post-comments__details">
                          <div class="single-post-comments__date">
                            {comment.date}
                          </div>
                          <div class="single-post-comments__autor">
                            {comment.autor}
                          </div>
                        </div>
                        <a
                          href="#commentForm"
                          class="single-post-comments__reply-button"
                        >
                          <span>{t("singlePost", "comments.replyButton")}</span>
                        </a>
                      </header>
                      <div class="single-post-comments__content">
                        {comment.text}
                      </div>
                    </div>
                    {comment.replies && comment.replies.length > 0 && (
                      <div class="single-post-comments__replies">
                        {comment.replies?.map((reply) => (
                          <div class="single-post-comments__comment">
                            <div class="single-post-comments__wrapper">
                              <header class="single-post-comments__header">
                                <div class="single-post-comments__details">
                                  <div class="single-post-comments__date">
                                    {reply.date}
                                  </div>
                                  <div class="single-post-comments__autor">
                                    {reply.autor}
                                  </div>
                                </div>
                                <a
                                  href="#commentForm"
                                  class="single-post-comments__reply-button"
                                >
                                  <span>
                                    {t("singlePost", "comments.replyButton")}
                                  </span>
                                </a>
                              </header>
                              <div class="single-post-comments__content">
                                {reply.text}
                              </div>
                            </div>
                          </div>
                        ))}
                      </div>
                    )}
                  </div>
                ))}
              </div>
            </div>
          )
        }
        <div class="comments-single-post__body">
          <header class="comments-single-post__header">
            <h2
              class="comments-single-post__title"
              id="comments-single-post-title"
            >
              {t("singlePost", "commentForm.title")}
            </h2>
          </header>
          <BlogCommentForm
            commentFormData={t("singlePost", "commentForm.fields")}
          />
        </div>
      </div>
    </div>
  </section>

  {
    post.data.relatedPosts?.length > 0 && (
      <SwiperIniter>
        <section
          class="single-post-related"
          aria-labelledby="single-post-related-title"
        >
          <div class="single-post-related__container">
            <header class="single-post-related__header">
              <button
                type="button"
                class="single-post-related__button single-post-related__button-prev"
              >
                <i class="fa fa-caret-left fa-lg" />
              </button>
              <h2
                class="single-post-related__title"
                id="single-post-related-title"
              >
                {t("singlePost", "relatedPosts.title")}
              </h2>
              <button
                type="button"
                class="single-post-related__button single-post-related__button-next"
              >
                <i class="fa fa-caret-right fa-lg" />
              </button>
            </header>
            <div class="single-post-related__body">
              <div class="single-post-related__swiper swiper">
                <div class="single-post-related__wrapper swiper-wrapper">
                  <div class="single-post-related__slide swiper-slide swiper-slide-next" style="width: 300px; margin-right: 40px;"><article class="blog-card" id="15"><div class="blog-card__visual"><a href="/astro-drummers-blog/blog/dein-erstes-homestudio-einrichten-ohne-die-bank-zu-sprengen" class="blog-card__image ibg"><img src="/astro-drummers-blog/_image?href=https%3A%2F%2Fpicsum.photos%2Fseed%2Fdrummersblog-03%2F600%2F900&amp;w=800&amp;h=800" data-image-component="true" alt="Dein erstes Homestudio einrichten, ohne die Bank zu sprengen" loading="lazy" decoding="async" width="800" height="800"></a><div class="blog-card__share"><div class="share-dropdown" data-dropdown="horizontal"><button type="button" class="share-dropdown__button" data-dropdown-trigger=""><i class="fa fa-share-alt"> </i></button><div class="share-dropdown__body" data-dropdown-body=""><ul class="share-dropdown__list"><li class="share-dropdown__item"><a href="#" class="share-dropdown__link share-dropdown__link-01"><i class="fa fa-envelope"></i></a></li><li class="share-dropdown__item"><a href="#" class="share-dropdown__link share-dropdown__link-02"><i class="fa fa-google-plus"></i></a></li><li class="share-dropdown__item"><a href="#" class="share-dropdown__link share-dropdown__link-03"><i class="fa fa-twitter"></i></a></li><li class="share-dropdown__item"><a href="#" class="share-dropdown__link share-dropdown__link-04"><i class="fa fa-facebook"></i></a></li></ul></div></div></div></div><div class="blog-card__body"><a href="/astro-drummers-blog/blog/dein-erstes-homestudio-einrichten-ohne-die-bank-zu-sprengen" class="blog-card__link"><h2 class="blog-card__title">Dein erstes Homestudio einrichten, ohne die Bank zu sprengen</h2></a><div class="blog-card__description">Du brauchst weder einen akustisch behandelten Raum noch fünfstelliges Equipment, um ernsthaft mit dem Aufnehmen zu beginnen. Das zählt wirklich, wenn du bei null startest.</div><footer class="blog-card__footer"><span class="blog-card__date">09.02.2026 </span><a href="" class="blog-card__autor"> </a></footer></div></article></div>
                  <div class="single-post-related__slide swiper-slide swiper-slide-next" style="width: 300px; margin-right: 40px;"><article class="blog-card" id="15"><div class="blog-card__visual"><a href="/astro-drummers-blog/blog/dein-erstes-homestudio-einrichten-ohne-die-bank-zu-sprengen" class="blog-card__image ibg"><img src="/astro-drummers-blog/_image?href=https%3A%2F%2Fpicsum.photos%2Fseed%2Fdrummersblog-03%2F600%2F900&amp;w=800&amp;h=800" data-image-component="true" alt="Dein erstes Homestudio einrichten, ohne die Bank zu sprengen" loading="lazy" decoding="async" width="800" height="800"></a><div class="blog-card__share"><div class="share-dropdown" data-dropdown="horizontal"><button type="button" class="share-dropdown__button" data-dropdown-trigger=""><i class="fa fa-share-alt"> </i></button><div class="share-dropdown__body" data-dropdown-body=""><ul class="share-dropdown__list"><li class="share-dropdown__item"><a href="#" class="share-dropdown__link share-dropdown__link-01"><i class="fa fa-envelope"></i></a></li><li class="share-dropdown__item"><a href="#" class="share-dropdown__link share-dropdown__link-02"><i class="fa fa-google-plus"></i></a></li><li class="share-dropdown__item"><a href="#" class="share-dropdown__link share-dropdown__link-03"><i class="fa fa-twitter"></i></a></li><li class="share-dropdown__item"><a href="#" class="share-dropdown__link share-dropdown__link-04"><i class="fa fa-facebook"></i></a></li></ul></div></div></div></div><div class="blog-card__body"><a href="/astro-drummers-blog/blog/dein-erstes-homestudio-einrichten-ohne-die-bank-zu-sprengen" class="blog-card__link"><h2 class="blog-card__title">Dein erstes Homestudio einrichten, ohne die Bank zu sprengen</h2></a><div class="blog-card__description">Du brauchst weder einen akustisch behandelten Raum noch fünfstelliges Equipment, um ernsthaft mit dem Aufnehmen zu beginnen. Das zählt wirklich, wenn du bei null startest.</div><footer class="blog-card__footer"><span class="blog-card__date">09.02.2026 </span><a href="" class="blog-card__autor"> </a></footer></div></article></div>
                  <div class="single-post-related__slide swiper-slide swiper-slide-next" style="width: 300px; margin-right: 40px;"><article class="blog-card" id="15"><div class="blog-card__visual"><a href="/astro-drummers-blog/blog/dein-erstes-homestudio-einrichten-ohne-die-bank-zu-sprengen" class="blog-card__image ibg"><img src="/astro-drummers-blog/_image?href=https%3A%2F%2Fpicsum.photos%2Fseed%2Fdrummersblog-03%2F600%2F900&amp;w=800&amp;h=800" data-image-component="true" alt="Dein erstes Homestudio einrichten, ohne die Bank zu sprengen" loading="lazy" decoding="async" width="800" height="800"></a><div class="blog-card__share"><div class="share-dropdown" data-dropdown="horizontal"><button type="button" class="share-dropdown__button" data-dropdown-trigger=""><i class="fa fa-share-alt"> </i></button><div class="share-dropdown__body" data-dropdown-body=""><ul class="share-dropdown__list"><li class="share-dropdown__item"><a href="#" class="share-dropdown__link share-dropdown__link-01"><i class="fa fa-envelope"></i></a></li><li class="share-dropdown__item"><a href="#" class="share-dropdown__link share-dropdown__link-02"><i class="fa fa-google-plus"></i></a></li><li class="share-dropdown__item"><a href="#" class="share-dropdown__link share-dropdown__link-03"><i class="fa fa-twitter"></i></a></li><li class="share-dropdown__item"><a href="#" class="share-dropdown__link share-dropdown__link-04"><i class="fa fa-facebook"></i></a></li></ul></div></div></div></div><div class="blog-card__body"><a href="/astro-drummers-blog/blog/dein-erstes-homestudio-einrichten-ohne-die-bank-zu-sprengen" class="blog-card__link"><h2 class="blog-card__title">Dein erstes Homestudio einrichten, ohne die Bank zu sprengen</h2></a><div class="blog-card__description">Du brauchst weder einen akustisch behandelten Raum noch fünfstelliges Equipment, um ernsthaft mit dem Aufnehmen zu beginnen. Das zählt wirklich, wenn du bei null startest.</div><footer class="blog-card__footer"><span class="blog-card__date">09.02.2026 </span><a href="" class="blog-card__autor"> </a></footer></div></article></div>
                  {post.data.relatedPosts.map((relatedPost) => {
                    const postUrl = getPostLink(relatedPost.slug, lang);
                    
                    return (
                      
                    
                      <div class="single-post-related__slide swiper-slide">
                        <BlogCardAlt
                          id={relatedPost.id}
                          postId={relatedPost.id}
                          src={relatedPost.cover}
                          alt={relatedPost.alt}
                          title={relatedPost.title}
                          description={relatedPost.description}
                          date={getFormattedDate(relatedPost.date)}
                          postUrl={postUrl}
                          autor={relatedPost.autor}
                        />
                      </div>
                    );
                    
                  })}
                </div>
              </div>
            </div>
          </div>
        </section>
      </SwiperIniter>
    )
  }
</Layout>
