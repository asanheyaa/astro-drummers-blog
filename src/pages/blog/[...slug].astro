---
import { Image } from "astro:assets";
import HeroSection from "../../components/HeroSection.astro";
import {
  getCategoryLink,
  getCommentsLink,
  getFormattedDate,
  getPostLink,
  getTagLink,
} from "../../scripts/utils";
import { useTranslations } from "../../scripts/i18n";
import ShareButtons from "../../components/SocialsButtons.astro";
import BlogCommentForm from "../../components/BlogCommentForm.astro";
import Category from "../../components/Category.astro";
import Date from "../../components/Date.astro";
import SwiperIniter from "../../components/SwiperIniter.astro";
import BlogCard from "../../components/BlogCard.astro";
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import BlogArticlesWidget from "../../components/BlogArticlesWidget.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts");

  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

const { post } = Astro.props;

const { lang } = Astro.locals;

const t = useTranslations(lang);
---

<Layout
  articleId={post.data.translationId}
  language={lang}
  title={post.data.title}
  metaDescription={post.data.description}
  description={post.data.description}
  ogLocale={t("blog", "meta.og.locale")}
  ogUrl={t("blog", "meta.og.url")}
  ogImageUrl={post.data.cover}
  ogImageSecureUrl={t("blog", "meta.og.imageSecureUrl")}
  ogImageAlt={post.data.title}
  twitterImageUrl={post.data.cover}
  twitterLabel1="Written by"
  twitterData1={"Ole Fahnick"}
  twitterLabel2="Time to read"
  twitterData2="Less than a minute"
  ogType="Article"
>
  <HeroSection
    isAlt
    title={post.data.title}
    date={getFormattedDate(post.data.date) }
    commentsCounter={post.data.comments?.length || 0}
    viewsCounter={post.data.counters?.views || 0}
    likesCounter={post.data.counters?.likes || 0}
    slug={post.data.slug}
    commentsLink={getCommentsLink(
      post.data.slug,
      lang,
      post.data.comments.length
    )}
    noFilter
    isArticle
  />

  <div class="content-wrapper">
    <div class="content-wrapper__container">
      <div class="content-wrapper__main">
        <section class="single-post-body">
          <!-- <div class="single-post-body__buttons">
            <ShareButtons
              isVertical
              facebookCounter={post.data.counters?.facebookCounter || 0}
              class="single-post-body__share"
              slug={post.data.slug}
            />
          </div> -->
          <article class="single-post-body__article">
            <div class="single-post-body__cover ibg">
              <Image
                width={985}
                height={660}
                alt={post.data.title}
                src={post.data.cover}
              />
            </div>
            <h3 class="single-post-body__title">
              {post.data.title}
            </h3>
            <div
              class="single-post-body__content"
              set:html={post.data.content.rendered}
            />
          </article>
          <footer class="footer-single-post">
            <div class="footer-single-post__container">
              <div class="footer-single-post__categories">
                <ul class="footer-single-post__list">
                  {
                    post.data.tags?.map((item) => (
                      <li class="footer-single-post__item">
                        <Category
                          label={item.title}
                          url={getTagLink(item.title, lang)}
                          class="footer-single-post__category"
                        />
                      </li>
                    ))
                  }
                </ul>
              </div>
              <div class="footer-single-post__actions">
                <button type="button" class="footer-single-post__button">
                  <i
                    class="footer-single-post__like-icon dfd-socicon-icon-ios7-heart"
                  >
                  </i>
                  <span class="footer-single-post__like-counter">
                    {post.data.counters?.likes || 0}
                  </span>
                  {" "}
                  <span>
                    {t("singlePost", "likes")}
                  </span>
                </button>
                <div class="footer-single-post__socials">
                  <ShareButtons
                    slug={post.data.slug}
                    facebookCounter={post.data.counters?.facebookCounter || 0}
                  />
                </div>
              </div>
            </div>
          </footer>
        </section>
        {
          post.data.relatedPosts?.length > 0 && (
            <SwiperIniter>
              <section
                class="single-post-related"
                aria-labelledby="single-post-related-title"
              >
                <h2
                  class="single-post-related__title"
                  id="single-post-related-title"
                >
                  {t("singlePost", "relatedPosts.title")}
                </h2>
                <div class="single-post-related__body">
                  <div class="single-post-related__swiper swiper">
                    <div class="single-post-related__wrapper swiper-wrapper">
                      {post.data.relatedPosts.map((relatedPost) => {
                        const postUrl = getPostLink(relatedPost.slug, lang);
                        const commentsUrl = getCommentsLink(
                          relatedPost.slug,
                          lang,
                          relatedPost.counters?.comments || 0
                        );
                        const categoryUrl = getCategoryLink(
                          relatedPost.category,
                          lang
                        );
                        return (
                          <div class="single-post-related__slide swiper-slide">
                            <BlogCard
                              src={relatedPost.cover}
                              alt={relatedPost.alt}
                              date={getFormattedDate(relatedPost.date)}
                              title={relatedPost.title}
                              postUrl={postUrl}
                              isGrid
                              isAlt
                              category={relatedPost.category}
                              categoryUrl={categoryUrl}
                              likesCounter={relatedPost.counters?.likes || 0}
                              commentsCounter={
                                relatedPost.counters?.comments || 0
                              }
                              commentsLink={commentsUrl}
                            />
                          </div>
                        );
                      })}
                      
                    </div>
                  </div>
                </div>
              </section>
            </SwiperIniter>
          )
        }
        <div class="content-wrapper__comments">
          {
            post.data.comments?.length > 0 && (
              <section
                class="single-post-comments"
                aria-labelledby="single-post-comments-title"
                id="comments"
              >
                <h2
                  class="single-post-comments__title"
                  id="single-post-comments-title"
                >
                  {t(
                    "singlePost",
                    `comments.${post.data.comments.length === 1 ? "commentsCountOne" : "commentsCountOther"}`,
                    { count: post.data.comments.length }
                  )}
                </h2>
                <div class="single-post-comments__body">
                  {post.data.comments?.map((comment) => (
                    <div class="single-post-comments__comment">
                      <div class="single-post-comments__wrapper">
                        <header class="single-post-comments__header">
                          <div class="single-post-comments__details">
                            {comment.url ? (
                              <a
                                href={comment.url}
                                class="single-post-comments__autor"
                              >
                                {comment.autor}
                              </a>
                            ) : (
                              <div class="single-post-comments__autor">
                                {comment.autor}
                              </div>
                            )}
                            <Date date={comment.date} />
                          </div>
                          <a
                            href="#commentForm"
                            class="single-post-comments__reply-button"
                          >
                            <i class="dfd-socicon-icon-reply-all single-post-comments__reply-icon" />
                            <span>{t("singlePost", "comments.replyButton")}</span>
                          </a>
                        </header>
                        <div class="single-post-comments__content">
                          {comment.text}
                        </div>
                      </div>
                      {comment.replies && comment.replies.length > 0 && (
                        <div class="single-post-comments__replies">
                          {comment.replies?.map((reply) => (
                            <div class="single-post-comments__comment">
                              <div class="single-post-comments__wrapper">
                                <header class="single-post-comments__header">
                                  <div class="single-post-comments__details">
                                    {reply.url ? (
                                      <a
                                        href={reply.url}
                                        class="single-post-comments__autor"
                                      >
                                        {reply.autor}
                                      </a>
                                    ) : (
                                      <div class="single-post-comments__autor">
                                        {reply.autor}
                                      </div>
                                    )}
                                    <Date date={reply.date} />
                                  </div>
                                  <a
                                    href="#commentForm"
                                    class="single-post-comments__reply-button"
                                  >
                                    <i class="dfd-socicon-icon-reply-all single-post-comments__reply-icon" />
                                    <span>
                                      {t("singlePost", "comments.replyButton")}
                                    </span>
                                  </a>
                                </header>
                                <div class="single-post-comments__content">
                                  {reply.text}
                                </div>
                              </div>
                            </div>
                          ))}
                        </div>
                      )}
                    </div>
                  ))}
                </div>
              </section>
            )
          }
          <section
            class="comments-single-post"
            aria-labelledby="comments-single-post-title"
            id="commentForm"
          >
            <div class="comments-single-post__body">
              <header class="comments-single-post__header">
                <h2
                  class="comments-single-post__title"
                  id="comments-single-post-title"
                >
                  {t("singlePost", "commentForm.title")}
                </h2>
                <div class="comments-single-post__subtitle">
                  {t("singlePost", "commentForm.subtitle")}
                </div>
              </header>
              <BlogCommentForm
                commentFormData={t("singlePost", "commentForm.fields")}
              />
            </div>
          </section>
        </div>
      
      </div>
      <BlogArticlesWidget  isAlt inputPlaceholder={t("blog", "blog.asideWidget.inputPlaceholder")}/>
    </div>
  </div>
</Layout>
