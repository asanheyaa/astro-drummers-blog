---
import { getCollection } from "astro:content";
import HeroSection from "../../../../components/HeroSection.astro";
import Layout from "../../../../layouts/Layout.astro";

import { useTranslations } from "../../../../scripts/i18n.js";
import {
  getCategoriesWithPosts,
  getCategoryLink,
  getFormattedDate,
  getPostLink,
} from "../../../../scripts/utils.js";
import BlogArticlesWidget from "../../../../components/BlogArticlesWidget.astro";
import BlogCardAlt from "../../../../components/BlogCardAlt.astro";

const { lang } = Astro.locals;
const t = useTranslations(lang);

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  const categories = getCategoriesWithPosts(posts, "de");
 
  return categories.map((cat) => ({
    params: { category: cat.slug },
    props: { category:cat, allCategories: categories },
  }));
}

const { category, allCategories } =
  Astro.props;

  
---

<Layout
  title={`${category.title} ${t("categories", "pageTitlePrefix")}`}
  metaDescription={t("categories", "meta.metaDescription")}
  ogLocale={t("categories", "meta.og.locale")}
  ogUrl={t("categories", "meta.og.url")}
  ogImageUrl={t("categories", "meta.og.image")}
  ogImageSecureUrl={t("categories", "meta.og.imageSecureUrl")}
  ogImageAlt={t("categories", "meta.og.imageAlt")}
  twitterImageUrl={t("categories", "meta.twitter.image")}
  twitterLabel1={t("categories", "meta.twitter.label1")}
  twitterData1={t("categories", `${category.posts.length || 0}`)}
  categoryId={category.id}
>
  <HeroSection
    title={`${t("categories", "hero.title")} ${category.title}`}
    categories={allCategories}
    categoryName={category.title}
    searchTitle={t("blog", "blog.hero.searchTitle")}
    searchPlaceholder={t("blog", "blog.hero.searchPlaceholder")}
    filterTitle={t("blog", "blog.hero.filterTitle")}
  />
  <section class="blog-articles blog-articles-with-widget">
    <div class="blog-articles__container">
      <div class="blog-articles__body">
        {
          category.posts.map((article) => {
            const postUrl = getPostLink(article.data.slug, lang);
            const categoryUrl = getCategoryLink(
            article.data.category.title,
              lang
            );
            return (
              <BlogCardAlt
                id={article.data.id}
                postId={article.data.id}
                src={article.data.cover}
                alt={article.data.alt}
                title={article.data.title}
                description={article.data.description}
                date={getFormattedDate(article.data.date)}
                category={article.data.category.title}
                categoryUrl={categoryUrl}
                postUrl={postUrl}
                autor={article.data.autor}
                isGrid
              />
            );
          })
        }
      </div>
      <BlogArticlesWidget inputPlaceholder={t("blog", "blog.asideWidget.inputPlaceholder")} />
    </div>
  </section>
</Layout>
